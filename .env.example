# PayPal Developer Sandbox credentials (https://developer.paypal.com)
# Only needed for AGENTGUARD_MODE=live. Mock mode needs nothing.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Optional: enables the Gemini second-opinion risk evaluator.
# Without it, a built-in heuristic evaluator is used.
GEMINI_API_KEY=

# mock (default, offline, no credentials) | live (real PayPal Sandbox calls)
AGENTGUARD_MODE=mock
